  },
  "item": [
    {
      "name": "1 Add book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/books",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookName\": \"Spring in Action\",\n  \"author\": \"Craig Walls\",\n  \"price\": 650.0,\n  \"available\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
